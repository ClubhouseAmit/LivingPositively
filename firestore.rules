rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
		// ---------------------------------------------------------
		// Rowy rules start
		// ---------------------------------------------------------
		// Automatically generated and managed by Rowy
		// ⚠️ Do not edit this block directly, as it will be overwritten
		// To edit the security rules, please do it on different block or manage from rowy settings
		// initialized on 4/3/2024
		match /{collectionId}/{docId} {
			allow read: if colRule(["AboutPage-Text"], ["ADMIN","EDITOR","VIEWER","OWNER"]);
			allow create, delete: if colRule(["AboutPage-Text"], ["ADMIN","EDITOR","OWNER"]);
			allow update: if colRule(["AboutPage-Text"], ["ADMIN","OWNER"]);
			
			function colRule(collections, roles){
				return collectionId in collections && hasAnyRole(roles);
			}
			
		}
		match /{somePath=**}/{collectionGroupId}/{docId}{
			allow read: if colRule(["allData"], ["ADMIN","EDITOR","VIEWER","OWNER"]);
			allow create, update, delete: if colRule(["allData"], ["ADMIN","EDITOR","OWNER"]);
			
			function colRule(collections, roles){
				return collectionGroupId in collections && hasAnyRole(roles);
			}
			
		}
		
		// ---------------------------------------------------------
		// Rowy rules end
		// ---------------------------------------------------------
		// Collections owned entirely by the notification backend. Clients never
		// read or write them directly: every client interaction goes through the
		// authenticated Cloud Functions, which use the Admin SDK and bypass these
		// rules. See docs/adr/ADR-015-firestore-access-policy-fcm-notification-
		// collections.md.
		//
		// The exclusion lives in the catch-all's own condition because Firestore
		// OR-combines every matching rule: a narrower "allow read, write: if false"
		// block cannot revoke a grant made here, it can only sit beside it.
		//
		// quotes_* is matched by prefix rather than listed literally because the
		// scheduler resolves the collection name from
		// notification_types.quotesCollections[locale]; a new locale must not land
		// outside this list.
		function serverOnlyCollection(collectionId) {
			return collectionId in [
				"devices",
				"scheduled_notifications",
				"notification_deliveries",
				"notification_scheduler_state",
				"notification_mutation_state",
				"notification_types"
			] || collectionId.matches("quotes_.*");
		}
		// Allow all users to read all documents, except the server-only
		// collections above. devices/{uid} keeps its owner-scoped rule below,
		// which is now the only grant on that collection.
		match /{collectionId}/{document=**} {
			allow read: if !serverOnlyCollection(collectionId);
			allow write: if hasAnyRole(["ADMIN", "OWNER"]) &&
				!serverOnlyCollection(collectionId);
		}
		// Rowy: Allow signed in users to read Rowy configuration and admins to write
		match /_rowy_/{docId} {
			allow read: if true;
			allow write: if hasAnyRole(["ADMIN", "OWNER"]);
			match /{document=**} {
				allow read: if true;
				allow write: if hasAnyRole(["ADMIN", "OWNER"]);
			}
		}
		// Rowy: Allow users to edit their settings
		match /_rowy_/userManagement/users/{userId} {
			allow get, update, delete: if isDocOwner(userId);
			allow create: if request.auth.token.roles.size() > 0;
		}
		// Rowy: Allow public to read public Rowy configuration
		match /_rowy_/publicSettings {
			allow get: if true;
		}
		
		// Rowy: Utility functions
		function isDocOwner(docId) {
			return request.auth != null && (request.auth.uid == resource.id || request.auth.uid == docId);
		}
		function hasAnyRole(roles) {
			return request.auth != null && request.auth.token.roles.hasAny(roles);
		}
match /users/{userId} {
  allow read: if true;
  allow write: if request.auth != null && request.auth.uid == userId;
}
// Device table — each user can only write their own doc
match /devices/{uid} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}
	}
}