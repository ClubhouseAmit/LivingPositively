{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/http_cors.test.js lib/notification_validation.test.js lib/notification_provisioning.test.js lib/scheduled_delivery.test.js",
    "provision:notifications": "npm run build && node lib/provision_notifications.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "overrides": {
    "@google-cloud/storage": "^8.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "typescript": "^6.0.0"
  },
  "private": true
}
